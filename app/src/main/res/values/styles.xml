<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">@color/vb_accent</item>
        <item name="android:colorPrimary">@color/vb_bg</item><item name="android:colorPrimaryDark">@color/vb_bg</item>
        <item name="android:colorControlActivated">@color/vb_accent</item><item name="android:colorControlNormal">@color/vb_muted</item>
        <item name="android:colorBackground">@color/vb_bg</item><item name="android:colorBackgroundFloating">@color/vb_surface_hi</item>
        <item name="android:textColorPrimary">@color/vb_fg</item><item name="android:textColorSecondary">@color/vb_muted</item>
        <item name="android:textColorHint">@color/vb_muted</item><item name="android:textColorLink">@color/vb_accent</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:windowLightStatusBar">false</item><item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item><item name="android:windowBackground">@color/vb_bg</item>
        <item name="android:navigationBarColor">@color/vb_bg</item><item name="android:statusBarColor">@color/vb_bg</item>
    </style>
    <style name="AppDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/vb_accent</item>
        <item name="android:colorBackground">@color/vb_surface_hi</item><item name="android:colorBackgroundFloating">@color/vb_surface_hi</item>
        <item name="android:windowBackground">@color/vb_surface_hi</item>
        <item name="android:textColorPrimary">@color/vb_fg</item><item name="android:textColorSecondary">@color/vb_muted</item>
        <item name="android:textColorHint">@color/vb_muted</item><item name="android:textColorLink">@color/vb_accent</item>
        <item name="android:colorControlActivated">@color/vb_accent</item><item name="android:colorControlNormal">@color/vb_muted</item>
    </style>
</resources>
